{
  "name": "home-planner",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first 3D home furnishing planner. Arrange, measure, save, and explore.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harrison-quant-h2/home-planner.git"
  },
  "bugs": "https://github.com/harrison-quant-h2/home-planner/issues",
  "homepage": "https://github.com/harrison-quant-h2/home-planner#readme",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "vite": "8.2.2"
  }
}
